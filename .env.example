# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않음)

# true: Supabase·백엔드 없이 브라우저 안 가짜 데이터로 실행 (데모 계정 hansul / hansul123)
# false: 아래 Supabase 값으로 실제 로그인
VITE_USE_MOCK=true

# Supabase 대시보드 > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 아이디 → Supabase 이메일 변환용 가짜 도메인 (hansol → hansol@hansul.app)
VITE_AUTH_EMAIL_DOMAIN=hansul.app

# 배포된 백엔드 주소 (예: https://hansul-api.vercel.app). 비우면 같은 주소의 /api 로 요청
VITE_API_BASE_URL=

# 개발 중 /api 를 넘겨줄 로컬 백엔드 주소 (예: http://localhost:3000). VITE_API_BASE_URL 은 비워두기
VITE_API_PROXY_TARGET=
